# Optional — enables cloud sync & backup (Phase 2).
# Without these, OpenKhata runs fully offline with all data on-device.
# See supabase/README.md for setup instructions.
NEXT_PUBLIC_SUPABASE_URL=
# Use ONE of the following (either works — set whichever your dashboard shows):
#   • New API keys:  NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#   • Legacy keys:   NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — Google Drive backup (Phase "Growth").
# A Google Cloud OAuth 2.0 Web client ID. Enable the Google Drive API and add
# the drive.appdata scope. Without it, the Drive backup buttons stay hidden.
# (Google *login* is configured separately in the Supabase dashboard.)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional — Donate button (SaaS phase). An external link (Ko-fi / BuyMeACoffee
# / a personal bKash number page). Shown on the landing page and in সেটিংস.
# Without it the donate buttons stay hidden.
NEXT_PUBLIC_DONATE_URL=

# Server-only — billing webhook (SaaS phase, DEFERRED until a payment provider
# is wired). The Supabase service-role key used by src/app/api/billing/webhook
# to grant paid entitlements. NEVER prefix this with NEXT_PUBLIC_ — it must not
# reach the browser. Leave empty until billing is integrated.
SUPABASE_SERVICE_ROLE_KEY=
